.data/
sera_memories*.json
sera_memories.json

# Launcher / server runtime logs
sera-server.log

# Backups & Temp files
backups/
tmp/
*.bak
*.bak.*
.scratch/

# Environment and Secrets (Never commit API keys)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
!.env.example

# Logs & Debugging
*.log
npm-debug.log*

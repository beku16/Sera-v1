# SERA server configuration.
# Copy this file to `.env` and uncomment what you need. Every value is
# optional — keys can also be added at runtime in Settings > API Keys
# (stored AES-256-GCM encrypted); env vars take priority over the vault.

# ── Online Mode ──────────────────────────────────────────────────────
# Gemini API key (https://aistudio.google.com/apikey). Online Mode also
# works when the key is configured only in the app's key vault.
GEMINI_API_KEY=""

# ── Server ───────────────────────────────────────────────────────────
# Port the Express + WebSocket server listens on. Default: 3000.
# PORT=3000

# Bind address. Default: 127.0.0.1 (localhost only, recommended — this
# server can control your computer). Never expose it to a network.
# SERA_BIND_HOST=127.0.0.1

# Optional shared-secret token (v1.6.11). When set, every /api request and
# every /api/live WebSocket connection must present it via
# "Authorization: Bearer <token>" or "?token=<token>". This also blocks
# other local processes (which can spoof Host headers). Leave empty for the
# normal browser/Electron experience.
# SERA_AUTH_TOKEN=""

# Per-minute budget for expensive endpoints (deep scans, model pulls,
# agent chats, repairs, desktop launches). A human never hits this; a
# runaway client retry loop gets 429s instead of spawning child processes.
# Set 0 to disable. Default: 60.
# SERA_RATE_LIMIT_PER_MIN=60

# Self-referential URL used by diagnostics and a few tools.
# APP_URL=http://localhost:3000

# Verbose server logging (per-chunk audio trace). Default: off.
# SERA_LOG_VERBOSE=true

# ── Local Mode (100% offline Ollama engine) ─────────────────────────
# Where the local Ollama daemon listens. Default: http://127.0.0.1:11434
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Override the auto-recommended Ollama model. Examples:
# qwen2.5:7b-instruct-q4_K_M | llama3.2:3b-instruct-q4_K_M
# SERA_LOCAL_MODEL=qwen2.5:7b-instruct-q4_K_M

# Persistent home for auto-installed engines (OCR data, Piper voices).
# Default: ~/.sera — outside the app folder so updates keep it.
# SERA_HOME=~/.sera

# Relocate the semantic memory store (personal data — keep local or in
# a synced folder). Default: .data/sera_memories.json
# SERA_MEMORY_FILE=.data/sera_memories.json

# ── Optional cloud providers (Settings > Models unlocks routing) ────
# Keys can live here or in the app's encrypted vault. Paid providers
# stay disabled until explicitly unlocked in Settings > Models.
# OPENAI_API_KEY=""
# DEEPSEEK_API_KEY=""
# GROQ_API_KEY=""
# OPENROUTER_API_KEY=""

# ── Local speech engines (optional, auto-detected if present) ───────
# whisper.cpp binary + model for offline speech-to-text.
# SERA_WHISPER_BIN=""
# SERA_WHISPER_MODEL=""
# Piper binary + voice for offline text-to-speech.
# SERA_PIPER_BIN=""
# SERA_PIPER_VOICE=""

# ── Restricted networks / DNS hijacking (optional) ──────────────────
# If your network hijacks plain-text DNS (diagnostics show private IPs)
# or you reach the internet through a local proxy (Clash, v2rayN,
# Zscaler...), set HTTPS_PROXY and SERA routes outbound fetch() calls
# through it. Local endpoints (Ollama at 127.0.0.1) are always exempt
# via NO_PROXY. For the Gemini Live voice socket, also enable Windows
# "DNS over HTTPS" or run your proxy app in TUN mode.
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1,::1
